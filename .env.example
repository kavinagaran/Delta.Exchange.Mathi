# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# Per-account API credentials live in users/<username>/account.json; the keys
# below are the fallback used when no account record supplies them.

# ── Exchange ──────────────────────────────────────────────────────────────
BASE_URL   = https://api.india.delta.exchange
API_KEY    = your-delta-api-key
API_SECRET = your-delta-api-secret
# Trading keys must have withdrawal permission DISABLED. See docs/security-checklist.md

# ── Trading mode ──────────────────────────────────────────────────────────
DRY_RUN    = true
UNDERLYING = BTC
PERPETUAL_SYMBOL = BTCUSD
STRIKE_STEP = 200

# ── Evening MOVE slot (IST 17:35 entry / 01:00 exit) ──────────────────────
ENTRY_H_UTC = 12
ENTRY_M_UTC = 5
EXIT_H_UTC  = 19
EXIT_M_UTC  = 30
STRADDLE_LOTS = 800
ORDER_SIZE  = 1
TP_TARGET_PNL = 150
TP_POLL_SECS  = 10

# ── Morning MOVE slot ─────────────────────────────────────────────────────
MORNING_ENABLED = false
MORNING_H_UTC = 1
MORNING_M_UTC = 0
MORNING_EXIT_H_UTC = 11
MORNING_EXIT_M_UTC = 30
MORNING_LOTS = 2000
TP_TARGET_PNL_MORNING = 150
TP_POLL_SECS_MORNING  = 10

# ── Signal parameters (legacy engine) ─────────────────────────────────────
CANDLE_RES = 5m
CANDLES_NEEDED = 320
EMA_FAST = 20
EMA_SLOW = 50
RSI_PERIOD = 14
RSI_BULLISH = 55
RSI_BEARISH = 45
SUPERTREND_ATR = 14
SUPERTREND_MULT = 3
POLL_INTERVAL = 60
MAX_TRADES_PER_DAY = 2

# ── Alerts ────────────────────────────────────────────────────────────────
TELEGRAM_ALERTS = false
TELEGRAM_BOT_TOKEN = your-telegram-bot-token
TELEGRAM_CHAT_ID   = your-telegram-chat-id
FAST2SMS_API_KEY   = your-fast2sms-key
ALERT_PHONE        = 9xxxxxxxxx

# ── Trend Engine (new, Phase 2+) ──────────────────────────────────────────
# The engine binds loopback only and is never proxied. The token is not a
# trust boundary; it stops a stray request becoming a trading input.
ENGINE_HOST = 127.0.0.1
ENGINE_PORT = 5055
ENGINE_TOKEN = generate-a-random-string
ENGINE_TIMEOUT_SECS = 1.5

# Which signal source drives automation. Rollback is a flip back to `legacy`.
# Never set to `engine` before the Phase 8 cutover criteria are met.
TREND_SIGNAL_SOURCE = legacy

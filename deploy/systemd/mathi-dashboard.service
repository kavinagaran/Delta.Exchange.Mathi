[Unit]
Description=BTC BOT Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mathi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/mathi/venv/bin/python dashboard.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/ubuntu/mathi/logs/dashboard.log
StandardError=append:/home/ubuntu/mathi/logs/dashboard.log

[Install]
WantedBy=multi-user.target

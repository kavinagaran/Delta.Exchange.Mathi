# BTC Trend Engine — EC2 unit (ADR 0001).
#
#   sudo cp deploy/systemd/btc-trend-engine.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now btc-trend-engine
#
# The StartLimit pair is deliberate: if the engine crash-loops 10 times in
# 5 minutes systemd STOPS retrying, the dashboard sees ENGINE_UNREACHABLE,
# and trading fails closed. Do not "fix" a crash loop by removing the limit.

[Unit]
Description=BTC Trend Engine (market data + trend signals, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to the deploy host.
User=ubuntu
WorkingDirectory=/home/ubuntu/Delta.Exchange.Mathi
EnvironmentFile=/home/ubuntu/Delta.Exchange.Mathi/.env
ExecStart=/home/ubuntu/Delta.Exchange.Mathi/.venv-engine/bin/python -m btc_trend_engine.api.app
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
# Graceful: SIGTERM cancels tasks, flushes the event store, closes the WS.
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/ubuntu/Delta.Exchange.Mathi/logs/engine.log
StandardError=append:/home/ubuntu/Delta.Exchange.Mathi/logs/engine.log

[Install]
WantedBy=multi-user.target
